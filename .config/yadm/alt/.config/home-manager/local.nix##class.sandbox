{ config, pkgs, lib, ... }:

{
  home.packages = with pkgs; [
    opencode
    opencode-desktop
    openssh
  ];
  programs.bash = {
    bashrcExtra = ''
      # One agent per sandbox run. It dies with the sandbox, so no cleanup is needed.
      if [ -z "$SSH_AUTH_SOCK" ]; then
        eval "$(ssh-agent -s)" > /dev/null
      fi
      ssh-add ~/.ssh/id_pijul
    '';
  };
}
